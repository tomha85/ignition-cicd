        "production": {
          "github_environment": "lab-packaging-production",
          "deployment_method": "eam",
          "target_id": "lab-packaging-production-agent",
          "secret_refs": [
            "IGNITION_EAM_API_TOKEN"
          ],
          "deployment_enabled": false,
          "approval_required": true
        }
      }
    }
  ]
