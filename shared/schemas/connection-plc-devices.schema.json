{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Factory plc-devices connection metadata: SOURCE ONLY (V1)",
  "description": "Git-reviewed connection metadata only. It does not configure Ignition or prove a live PLC, OPC UA or database connection.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "factory_id",
    "status",
    "deployment_enabled",
    "plc_devices"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "factory_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "status": {
      "enum": [
        "NOT_PROVIDED",
        "DOCUMENTED_NOT_APPLIED"
      ]
    },
    "deployment_enabled": {
      "const": false
    },
    "plc_devices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "gateway_id",
          "environment",
          "vendor",
          "protocol",
          "host",
          "port",
          "source_reference",
          "validation_state"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
          },
          "gateway_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "environment": {
            "enum": [
              "dev",
              "test",
              "production"
            ]
          },
          "vendor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "protocol": {
            "enum": [
              "ethernet-ip",
              "modbus-tcp",
              "siemens-s7",
              "opc-ua",
              "other"
            ]
          },
          "host": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "source_reference": {
            "type": "string",
            "minLength": 4,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/ -]{3,127}$"
          },
          "validation_state": {
            "const": "DOCUMENTED_NOT_RUNTIME_VERIFIED"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "NOT_PROVIDED"
          }
        }
      },
      "then": {
        "properties": {
          "plc_devices": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "DOCUMENTED_NOT_APPLIED"
          }
        }
      },
      "then": {
        "properties": {
          "plc_devices": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
