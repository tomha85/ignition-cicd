{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Explicit reviewed TEST LAB target registry V1",
  "type": "object",
  "required": [
    "schema_version",
    "targets"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "target_id",
          "factory_id",
          "gateway_id",
          "environment",
          "controller_id",
          "agent_id",
          "approved_project",
          "controller_stage_approved",
          "eam_send_commissioned",
          "production_approved"
        ],
        "additionalProperties": false,
        "properties": {
          "target_id": {
            "type": "string"
          },
          "factory_id": {
            "type": "string"
          },
          "gateway_id": {
            "type": "string"
          },
          "environment": {
            "const": "test"
          },
          "controller_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "agent_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "approved_project": {
            "type": [
              "string",
              "null"
            ]
          },
          "controller_stage_approved": {
            "type": "boolean"
          },
          "eam_send_commissioned": {
            "type": "boolean"
          },
          "production_approved": {
            "const": false
          },
          "eam_tasks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "project",
                "task_name",
                "agent_name"
              ],
              "additionalProperties": false,
              "properties": {
                "project": {
                  "type": "string"
                },
                "task_name": {
                  "type": "string"
                },
                "agent_name": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
